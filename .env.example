# Provider OpenRouter (padrao local) — embeddings via LFM2.5-Embedding-350M e LLM Gemma 4 31B free
EMBEDDING_PROVIDER=openrouter
LLM_PROVIDER=openrouter

COHERE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

COHERE_EMBED_MODEL=embed-multilingual-v3.0
OPENAI_EMBED_MODEL=text-embedding-3-small
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-small
OPENROUTER_EMBED_MODEL=intfloat/multilingual-e5-large
OPENROUTER_EMBED_DIMENSION=1024

OPENAI_CHAT_MODEL=gpt-4o-mini
COHERE_CHAT_MODEL=command-a-03-2025
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free

CHROMA_COLLECTION=assistente_univille
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_SLEEP_SECONDS=0
EMBEDDING_MAX_RETRIES=6
EMBEDDING_TOKENS_PER_MINUTE=0
EMBEDDING_RATE_LIMIT_RETRY_SECONDS=10
RETRIEVER_K=5
USE_COHERE_RERANK=false
COHERE_RERANK_MODEL=rerank-v4.0-fast
MIN_RERANK_SCORE=0.20
